# Copy to .env and change the token before running locally.
ADMIN_TOKEN=dev-token-change-me
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/switchboard.db
LOG_LEVEL=info

# v2: set to true for the project/environment API with local SQLite.
SWITCHBOARD_V2=false
V2_DB_PATH=./data/switchboard-v2.db

# Docker Compose: required by compose.yaml. Change it before exposing the stack.
POSTGRES_PASSWORD=change-me-before-use
# Optional host bindings (defaults keep both ports on localhost).
# BIND_ADDRESS=127.0.0.1
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432

# v2 with Postgres (takes precedence over SWITCHBOARD_V2):
# DATABASE_URL=postgres://switchboard:switchboard@127.0.0.1:5432/switchboard
