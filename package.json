{
  "name": "switchboard",
  "version": "1.0.0",
  "private": true,
  "description": "Small deterministic feature flag service",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-reporter=spec test/*.test.js test/v2/*.test.js test/db/*.test.js test/contract/*.test.js",
    "test:db": "node --test --test-reporter=spec test/db/postgres.test.js",
    "test:contract": "node --test --test-reporter=spec test/contract/ofrep.test.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:legacy": "node scripts/migrate-sqlite-to-postgres.mjs",
    "build": "npm run build --workspace @switchboard/sdk && npm run build --workspace @switchboard/openfeature-provider",
    "test:workspaces": "npm run build && npm run test --workspaces --if-present",
    "demo": "node scripts/demo.mjs",
    "demo:v2": "node scripts/demo-v2.mjs",
    "smoke": "bash scripts/smoke-docker.sh",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
