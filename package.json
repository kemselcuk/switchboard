{
  "name": "switchboard",
  "version": "1.0.0",
  "private": true,
  "description": "Small deterministic feature flag service",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-reporter=spec",
    "test:db": "node --test --test-reporter=spec test/db/**/*.test.js",
    "test:contract": "node --test --test-reporter=spec test/contract/**/*.test.js",
    "migrate": "node scripts/migrate.mjs",
    "build": "npm run build --workspaces --if-present",
    "demo": "node scripts/demo.mjs",
    "smoke": "bash scripts/smoke-docker.sh",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
